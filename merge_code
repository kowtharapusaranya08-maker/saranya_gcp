
MERGE saranya_dataset.orders_history AS target
USING (
  SELECT order_id, customer_id, product_id, order_date, amount, updated_at
    FROM
        (
	      SELECT
	              order_id,
		              customer_id,
			              product_id,
				              order_date,
					              amount,
						              updated_at,
							              row_number() OVER (PARTITION BY order_id ORDER BY updated_at DESC) AS rn
								            FROM saranya_dataset.orders_staging
									        )
										  WHERE rn = 1
										  ) AS source
										  ON target.order_id = source.order_id WHEN matched THEN update
										  SET
										    target.customer_id = source.customer_id,
										      target.product_id = source.product_id,
										        target.order_date = source.order_date,
											  target.amount = source.amount,
											    target.updated_at = source.updated_at
											        WHEN NOT matched
												      THEN
												              insert(
													                order_id, customer_id, product_id, order_date, amount, updated_at)
															          values(
																              source.order_id,
																	                  source.customer_id,
																			              source.product_id,
																				                  source.order_date,
																						              source.amount,
																							                  source.updated_at);
